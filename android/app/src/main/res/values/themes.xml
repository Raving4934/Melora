<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 浅色启动窗口：与 MeloraAppearance.canvas 浅色一致 -->
    <style name="Theme.Melora" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
    <!-- 仅恢复失败时使用；颜色与MeloraAppearance对应，不依赖尚未恢复的设置。 -->
    <style name="Theme.Melora.RecoveryDialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#2563EB</item>
        <item name="android:textColorPrimary">#111827</item>
        <item name="android:textColorSecondary">#6B7280</item>
        <item name="android:colorBackgroundFloating">#FFFFFF</item>
        <item name="android:windowMinWidthMinor">88%</item>
        <item name="android:windowMinWidthMajor">60%</item>
        <item name="android:backgroundDimAmount">0.32</item>
    </style>
</resources>
