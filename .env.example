# 说明模板：应用不自动载入该文件，请通过 shell 或服务管理器注入。
MELORA_ADDR=127.0.0.1:3780
# 显式设置时使用无符号链接的绝对路径：
# MELORA_DATA_DIR=/absolute/path/to/private-data
# WEB_DIR=/absolute/path/to/apps/web/dist
# 下载根留空表示禁止下载。目录必须事先存在，随后在 UI 中选择并验证。
MELORA_DOWNLOAD_ROOT=
# 非回环监听必须设置随机强令牌，切勿将实际令牌提交到仓库。
MELORA_AUTH_TOKEN=
MELORA_WEB_PORT=5173

# 以下由 FPK 生命周期自动设置，独立 npm dev 不要设置：
# MELORA_SOCKET=/absolute/app/target/app.sock
# MELORA_BASE_PATH=/app/melora
# MELORA_GATEWAY_AUTH=fnos-admin

# 仅回归测试需要；正常使用/FPK不要设置，默认是真实 WY 目录 + LX。
# MELORA_DEMO_MODE=1
