# 复制至 $TRIM_PKGETC/melora.env，由包用户持有，权限 0600。
# 这是逐行 KEY=VALUE 数据，不是 Shell 脚本：不加引号、不做变量替换。
# 缺少本字段（包括 0.1.0 旧配置）也默认 gateway，不需要重写旧配置。
MELORA_ACCESS_MODE=gateway
# 以下 TCP 地址和 token 仅用于显式 standalone 调试；gateway 不传入旧运行值。
MELORA_ADDR=127.0.0.1:3780
# gateway 留空时使用 fnOS 应用设置中已授权的目录，用户在网页中选择保存位置。
# 非空仅进一步收窄已授权范围，不自行授予权限；撤权后保留限制但停用对应下载。
# standalone 必须显式配置可写根；留空关闭下载，不采纳 TRIM_DATA_ACCESSIBLE_PATHS。
MELORA_DOWNLOAD_ROOT=
# standalone 非回环地址同时必须显式确认明文 HTTP 风险；gateway 会忽略此项。
MELORA_ALLOW_INSECURE_HTTP=0
# standalone 非回环地址必须配置 32–4096 字节 URL 安全随机 token。
# 不把真实 token 放进源码、FPK、URL、命令行参数或日志。
MELORA_AUTH_TOKEN=
